{
  "extends": "astro/tsconfigs/strictest",
  "compilerOptions": {
    "allowJs": false,
    "exactOptionalPropertyTypes": true,
    "jsx": "react-jsx",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "noUncheckedIndexedAccess": true,
    "types": ["./worker-configuration.d.ts", "bun", "@types/react", "@types/react-dom"]
  },
  "include": [".astro/types.d.ts", "src/**/*", "astro.config.ts", "drizzle.config.ts"],
  "exclude": ["dist", ".wrangler", "node_modules"]
}
