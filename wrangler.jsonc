{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "baro-preview",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-04",
  "compatibility_flags": ["nodejs_compat"],
  "ratelimits": [
    {
      "name": "CASE_IP_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "CASE_ACCOUNT_LIMIT",
      "namespace_id": "1002",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "ANALYSIS_ACCOUNT_LIMIT",
      "namespace_id": "1003",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "triggers": {
    "crons": ["* * * * *"]
  },
  "routes": [
    {
      "pattern": "preview.baro.site",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    }
  },
  "vars": {
    "APP_ENV": "local",
    "PUBLIC_BETA_ENABLED": "false",
    "RELEASE_SHA": "local",
    "BETTER_AUTH_URL": "https://preview.baro.site"
  },
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "bdb1ef93af2b424fa4bdf55a59a4e296"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "baro-preview",
      "database_id": "e8cdcf75-5bd8-469e-848e-f31816df4327",
      "migrations_dir": "drizzle"
    }
  ],
  "workflows": [
    {
      "name": "baro-analysis-preview",
      "binding": "ANALYSIS_WORKFLOW",
      "class_name": "AnalysisWorkflow"
    },
    {
      "name": "baro-file-processing-preview",
      "binding": "FILE_PROCESSING",
      "class_name": "FileProcessingWorkflow"
    }
  ],
  "env": {
    "preview": {
      "ratelimits": [
        {
          "name": "CASE_IP_LIMIT",
          "namespace_id": "1001",
          "simple": {
            "limit": 20,
            "period": 60
          }
        },
        {
          "name": "CASE_ACCOUNT_LIMIT",
          "namespace_id": "1002",
          "simple": {
            "limit": 5,
            "period": 60
          }
        },
        {
          "name": "ANALYSIS_ACCOUNT_LIMIT",
          "namespace_id": "1003",
          "simple": {
            "limit": 10,
            "period": 60
          }
        }
      ],
      "ai": {
        "binding": "AI"
      },
      "triggers": {
        "crons": ["* * * * *"]
      },
      "name": "baro-preview",
      "routes": [
        {
          "pattern": "preview.baro.site",
          "custom_domain": true
        }
      ],
      "vars": {
        "APP_ENV": "preview",
        "AI_GATEWAY_ID": "baro-preview",
        "PUBLIC_BETA_ENABLED": "false",
        "RELEASE_SHA": "unknown",
        "BETTER_AUTH_URL": "https://preview.baro.site"
      },
      "kv_namespaces": [
        {
          "binding": "SESSION",
          "id": "bdb1ef93af2b424fa4bdf55a59a4e296"
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "baro-preview",
          "database_id": "e8cdcf75-5bd8-469e-848e-f31816df4327",
          "migrations_dir": "drizzle"
        }
      ],
      "workflows": [
        {
          "name": "baro-analysis-preview",
          "binding": "ANALYSIS_WORKFLOW",
          "class_name": "AnalysisWorkflow"
        },
        {
          "name": "baro-file-processing-preview",
          "binding": "FILE_PROCESSING",
          "class_name": "FileProcessingWorkflow"
        }
      ],
      "r2_buckets": [
        {
          "binding": "CASE_PRIVATE_R2",
          "bucket_name": "baro-preview-v2-private"
        },
        {
          "binding": "PROFILE_PUBLIC_R2",
          "bucket_name": "baro-preview-v2-public"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "FILE_PROCESSOR",
            "class_name": "FileProcessorContainer"
          }
        ]
      },
      "exports": {
        "FileProcessorContainer": {
          "type": "durable-object",
          "storage": "sqlite"
        }
      },
      "containers": [
        {
          "name": "baro-file-processor-preview",
          "class_name": "FileProcessorContainer",
          "image": "./services/file-processor/Dockerfile",
          "image_build_context": ".",
          "instance_type": "standard-2",
          "max_instances": 1,
          "observability": {
            "enabled": false,
            "logs": {
              "enabled": false
            }
          }
        }
      ]
    },
    "production": {
      "ratelimits": [
        {
          "name": "CASE_IP_LIMIT",
          "namespace_id": "1001",
          "simple": {
            "limit": 20,
            "period": 60
          }
        },
        {
          "name": "CASE_ACCOUNT_LIMIT",
          "namespace_id": "1002",
          "simple": {
            "limit": 5,
            "period": 60
          }
        },
        {
          "name": "ANALYSIS_ACCOUNT_LIMIT",
          "namespace_id": "1003",
          "simple": {
            "limit": 10,
            "period": 60
          }
        }
      ],
      "ai": {
        "binding": "AI"
      },
      "triggers": {
        "crons": ["* * * * *"]
      },
      "name": "baro-production",
      "routes": [
        {
          "pattern": "baro.site",
          "custom_domain": true
        }
      ],
      "vars": {
        "APP_ENV": "production",
        "PUBLIC_BETA_ENABLED": "false",
        "RELEASE_SHA": "unknown",
        "BETTER_AUTH_URL": "https://baro.site"
      },
      "kv_namespaces": [
        {
          "binding": "SESSION",
          "id": "f42c32b464ae4a92b62214a63f091148"
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "baro-production",
          "database_id": "d315e93f-2fac-4cc2-bf99-e9d6eb31523f",
          "migrations_dir": "drizzle"
        }
      ],
      "workflows": [
        {
          "name": "baro-analysis-production",
          "binding": "ANALYSIS_WORKFLOW",
          "class_name": "AnalysisWorkflow"
        },
        {
          "name": "baro-file-processing-production",
          "binding": "FILE_PROCESSING",
          "class_name": "FileProcessingWorkflow"
        }
      ],
      "r2_buckets": [
        {
          "binding": "CASE_PRIVATE_R2",
          "bucket_name": "baro-production-v2-private"
        },
        {
          "binding": "PROFILE_PUBLIC_R2",
          "bucket_name": "baro-production-v2-public"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "FILE_PROCESSOR",
            "class_name": "FileProcessorContainer"
          }
        ]
      },
      "exports": {
        "FileProcessorContainer": {
          "type": "durable-object",
          "storage": "sqlite"
        }
      },
      "containers": [
        {
          "name": "baro-file-processor-production",
          "class_name": "FileProcessorContainer",
          "image": "./services/file-processor/Dockerfile",
          "image_build_context": ".",
          "instance_type": "standard-2",
          "max_instances": 1,
          "observability": {
            "enabled": false,
            "logs": {
              "enabled": false
            }
          }
        }
      ]
    }
  },
  "r2_buckets": [
    {
      "binding": "CASE_PRIVATE_R2",
      "bucket_name": "baro-preview-v2-private"
    },
    {
      "binding": "PROFILE_PUBLIC_R2",
      "bucket_name": "baro-preview-v2-public"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "FILE_PROCESSOR",
        "class_name": "FileProcessorContainer"
      }
    ]
  },
  "exports": {
    "FileProcessorContainer": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "containers": [
    {
      "name": "baro-file-processor-preview",
      "class_name": "FileProcessorContainer",
      "image": "./services/file-processor/Dockerfile",
      "image_build_context": ".",
      "instance_type": "standard-2",
      "max_instances": 1,
      "observability": {
        "enabled": false,
        "logs": {
          "enabled": false
        }
      }
    }
  ]
}
