{
  "name": "@baro/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.config.json",
    "test:ui": "jest --config jest.config.cjs --runInBand",
    "bundle": "expo export --platform ios --platform android --output-dir dist",
    "prebuild": "expo prebuild --no-install"
  },
  "dependencies": {
    "@babel/runtime": "7.29.10",
    "@baro/api-client": "workspace:*",
    "@baro/client-core": "workspace:*",
    "@baro/contracts": "workspace:*",
    "@better-auth/expo": "1.7.7",
    "@expo/metro-runtime": "58.0.15",
    "@noble/hashes": "2.4.0",
    "better-auth": "1.7.7",
    "expo": "58.0.17",
    "expo-constants": "58.0.13",
    "expo-crypto": "58.0.7",
    "expo-dev-client": "58.0.14",
    "expo-document-picker": "58.0.4",
    "expo-file-system": "58.0.10",
    "expo-linking": "58.0.14",
    "expo-network": "58.0.4",
    "expo-router": "58.0.25",
    "expo-secure-store": "58.0.2",
    "expo-sharing": "58.0.20",
    "expo-status-bar": "58.0.4",
    "expo-system-ui": "58.0.6",
    "expo-web-browser": "58.0.6",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.30.0",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.88.0",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "19.3.0",
    "jest": "30.5.2",
    "jest-expo": "58.0.12",
    "typescript": "6.0.3"
  }
}
