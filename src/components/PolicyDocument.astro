---
import * as drafts from "../content/policy-drafts";

interface Props {
  kind: keyof typeof drafts.policyDrafts;
}
const { kind } = Astro.props;
// biome-ignore lint/correctness/noUnusedVariables: Astro template reads policy.
const policy = drafts.policyDrafts[kind];
// biome-ignore lint/correctness/noUnusedVariables: Astro template reads the versions.
const version = drafts.POLICY_VERSIONS[kind];
---
<article data-product-policy-document="" class="min-w-0 space-y-6 text-sm leading-8 [overflow-wrap:anywhere]">
  <header data-product-policy-heading="" class="space-y-3 border-b border-[var(--pui-border)] pb-6">
    <span class="text-xs font-medium text-[var(--pui-muted)]">이용 안내 · {version}</span>
    <h1 class="text-3xl font-semibold tracking-tight">{policy.title}</h1>
    <p class="text-sm leading-7 text-[var(--pui-muted)]">{policy.description}</p>
  </header>
  {policy.sections.map((section) => <section data-product-policy-section="" class="space-y-3 rounded-2xl border border-[var(--pui-border)] bg-[var(--pui-surface)] p-5 sm:p-6" id={section.id}><h2 class="text-lg font-semibold">{section.title}</h2>{section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}</section>)}
  <nav class="flex flex-wrap gap-x-5 gap-y-2 border-t border-[var(--pui-border)] pt-4 text-xs text-[var(--pui-muted)] [&_a]:inline-flex [&_a]:min-h-11 [&_a]:items-center [&_a]:rounded [&_a]:underline [&_a]:underline-offset-4 [&_a]:focus-visible:outline-2 [&_a]:focus-visible:outline-[var(--pui-focus)]" aria-label="다른 이용 안내"><a href="/help">도움말</a><a href="/policies/terms">이용약관</a><a href="/policies/privacy">개인정보 처리방침</a><a href="/policies/ai">AI 이용 고지</a><a href="/settings">설정</a></nav>
</article>
