---
import {
  // biome-ignore lint/correctness/noUnusedImports: The Astro template renders these icons.
  ArrowDown,
  ArrowRight,
  Check,
  CheckCheck,
  ChevronRight,
  Clock3,
  FileText,
  FolderOpen,
  Image,
  MessageCircle,
  Mic,
  MoreHorizontal,
  Paperclip,
  Plus,
  ShieldCheck,
  Sparkles,
} from "lucide-react";
import "../../styles/landing-blue-reveal.css";

// biome-ignore lint/correctness/noUnusedVariables: The Astro template renders the feature descriptions.
const features = [
  {
    id: "conversation",
    label: "편한 대화",
    title: "잘 정리하지 않아도, 이야기는 시작돼요.",
    description: "어려운 말 대신, 지금 겪은 일을 편하게 들려주세요.",
    icon: MessageCircle,
    benefit: "내 말로 시작하는 사실 정리",
    action: "대화 직접 체험하기",
  },
  {
    id: "files",
    label: "자료 모으기",
    title: "여기저기 흩어진 기록을, 한곳에서.",
    description: "이야기에 필요한 자료를 모아, 확인할 사실과 연결해요.",
    icon: FolderOpen,
    benefit: "이야기와 자료를 함께 확인",
    action: "자료 정리 체험하기",
  },
  {
    id: "timeline",
    label: "타임라인",
    title: "뒤섞인 기억에도, 순서가 생겨요.",
    description: "언제 어떤 일이 있었는지, 확인한 내용부터 차근차근.",
    icon: Clock3,
    benefit: "날짜순으로 보는 사건의 흐름",
    action: "타임라인 체험하기",
  },
  {
    id: "report",
    label: "상담 리포트",
    title: "다시 설명할 걱정은, 한결 가볍게.",
    description: "내가 검토한 이야기와 선택한 자료로 상담을 준비해요.",
    icon: FileText,
    benefit: "마지막 검토와 공유 선택은 내가",
    action: "리포트 검토 체험하기",
  },
];
---

<section id="blue-app-reveal" class="blue-reveal" data-blue-reveal aria-labelledby="blue-reveal-title">
  <div class="blue-reveal-pin">
    <div class="blue-reveal-circle" aria-hidden="true"></div>
    <div class="blue-reveal-seed" aria-hidden="true"><img src="/brand/logo.svg" width="29" height="29" alt="" /></div>
    <header class="blue-reveal-opening">
      <p class="blue-reveal-eyebrow">A SMALL START. A CLEARER NEXT STEP.</p>
      <h2 id="blue-reveal-title">작은 시작 하나가,<br /><span>분명한 다음이 되도록.</span></h2>
      <p class="blue-reveal-opening-note">이야기를 꺼내는 순간, 새로운 화면이 열려요.</p>
    </header>
    <p class="blue-reveal-scroll-cue" aria-hidden="true"><span>스크롤해서, BARO 안으로</span><ArrowDown size={18} /></p>

    <div class="blue-reveal-experience">
      <div class="blue-reveal-heading"><span class="blue-reveal-wordmark">BARO <i>WORKSPACE</i></span><p data-blue-lead>잘 정리하지 않아도, 이야기는 시작돼요.</p><span data-blue-description>어려운 말 대신, 지금 겪은 일을 편하게 들려주세요.</span></div>

      <div class="blue-reveal-tabs" role="tablist" aria-label="BARO 작업 화면 살펴보기" data-blue-tabs hidden>
        {features.map((feature, index) => <button type="button" class="blue-reveal-tab" id={`blue-tab-${feature.id}`} role="tab" data-blue-tab={index} aria-controls={`blue-panel-${feature.id}`} aria-selected={index === 0 ? "true" : "false"} tabindex={index === 0 ? "0" : "-1"}><span class="blue-reveal-tab-face"><span class="blue-reveal-tab-icon"><feature.icon size={24} aria-hidden="true" /></span><span class="blue-reveal-tab-label">{feature.label}</span><span class="blue-reveal-tab-number">0{index + 1}</span></span></button>)}
      </div>

      <div class="blue-reveal-window">
        <div class="blue-reveal-windowbar"><span class="blue-reveal-window-dots" aria-hidden="true"><i></i><i></i><i></i></span><span class="blue-reveal-window-location"><ShieldCheck size={11} aria-hidden="true" /> 나의 이야기 · BARO</span><span class="blue-reveal-example">가상 화면 예시</span></div>
        <div class="blue-reveal-workspace">
          <aside class="blue-reveal-sidebar" aria-hidden="true"><div class="blue-reveal-app-brand"><img src="/brand/logo.svg" width="26" height="26" alt="" /><strong>BARO</strong></div><div class="blue-reveal-new"><Plus size={15} /><span>새 이야기</span></div><span class="blue-reveal-sidebar-label">나의 사건</span><div class="blue-reveal-case"><MessageCircle size={15} /><span>돌려받지 못한 돈</span></div><div class="blue-reveal-case-muted"><FolderOpen size={14} /><span>사건별로 모아보기</span></div><div class="blue-reveal-sidebar-bottom"><span class="blue-reveal-avatar">나</span><span>나의 공간</span><MoreHorizontal size={17} /></div></aside>

          <div class="blue-reveal-app-main">
            <div class="blue-reveal-app-top"><div><span class="blue-reveal-breadcrumb">나의 사건 <ChevronRight size={11} aria-hidden="true" /> 돌려받지 못한 돈</span><strong>내 이야기를 정리하는 공간</strong></div><span class="blue-reveal-app-state"><span></span> 내가 확인하는 이야기</span></div>
            <div class="blue-reveal-panels">
              {features.map((feature, index) => (
                <div class="blue-reveal-panel" id={`blue-panel-${feature.id}`} data-blue-panel={index} role="group" aria-labelledby={`blue-panel-title-${feature.id}`}>
                  <div class="blue-reveal-panel-title"><h3 id={`blue-panel-title-${feature.id}`}><feature.icon size={17} aria-hidden="true" />{feature.label}</h3><span>{feature.benefit}</span></div>

                  {feature.id === "conversation" && <div class="blue-app-chat"><div class="blue-app-chat-main"><div class="blue-app-greeting"><span><Sparkles size={21} aria-hidden="true" /></span><div><strong>어떤 일이 있었나요?</strong><p>정리되지 않은 이야기여도 괜찮아요.</p></div></div><div class="blue-app-chat-bubble">빌려준 돈을 아직 돌려받지 못했어요.</div><div class="blue-app-chat-reply"><img src="/brand/logo.svg" width="21" height="21" alt="" /><p>마음이 많이 쓰이셨겠어요.<br />언제, 어떤 방법으로 돈을 빌려주셨나요?</p></div><div class="blue-app-chat-bubble blue-app-chat-bubble-small">3월 12일에 계좌로 보냈어요.</div><div class="blue-app-input" aria-hidden="true"><Paperclip size={15} /><span>편하게 이야기해 주세요</span><span class="blue-app-input-send"><ArrowRight size={14} /></span></div></div><aside class="blue-app-facts"><span class="blue-app-small-heading">대화에서 정리한 사실</span><div><Check size={15} aria-hidden="true" /><span>대여 시점<strong>3월 12일</strong></span></div><div><Check size={15} aria-hidden="true" /><span>돈을 보낸 방법<strong>계좌 이체</strong></span></div><p>알고 있는 사실부터 정리해요.<br />모르는 건 나중에 이어서.</p></aside></div>}

                  {feature.id === "files" && <div class="blue-app-files"><div class="blue-app-files-intro"><div><strong>내 이야기와 함께 볼 자료</strong><p>문서와 사진, 녹음을 사건별로 모아요.</p></div><span>예시 자료 3개</span></div><div class="blue-app-file-row"><span class="blue-app-file-icon"><FileText size={23} aria-hidden="true" /></span><div><strong>계좌 이체 내역.pdf</strong><span>돈을 보낸 날짜와 금액</span></div><span class="blue-app-file-tag">대여 사실</span><Check size={17} aria-hidden="true" /></div><div class="blue-app-file-row"><span class="blue-app-file-icon is-violet"><Image size={23} aria-hidden="true" /></span><div><strong>주고받은 대화.png</strong><span>돌려주기로 약속한 내용</span></div><span class="blue-app-file-tag">반환 약속</span><Check size={17} aria-hidden="true" /></div><div class="blue-app-file-row"><span class="blue-app-file-icon is-mint"><Mic size={23} aria-hidden="true" /></span><div><strong>통화 녹음.m4a</strong><span>이후 나눈 이야기를 함께 확인</span></div><span class="blue-app-file-tag">추가 확인</span><Check size={17} aria-hidden="true" /></div><p class="blue-app-material-note"><Paperclip size={13} aria-hidden="true" />자료가 아직 없어도, 이야기부터 시작할 수 있어요.</p></div>}

                  {feature.id === "timeline" && <div class="blue-app-timeline"><div class="blue-app-timeline-intro"><strong>이제, 일의 흐름이 보여요.</strong><span>확인한 사실 · 확인할 내용</span></div><ol><li><time>3월 12일</time><div><strong>돈을 빌려줬어요</strong><p>계좌로 보낸 날짜를 확인했어요.</p><span><Paperclip size={11} aria-hidden="true" />계좌 이체 내역.pdf</span></div><i>자료 연결</i></li><li><time>4월 12일</time><div><strong>약속한 반환일이 지났어요</strong><p>메시지에 남은 약속 날짜를 함께 봐요.</p></div><i>내용 확인</i></li><li><time>다음 확인</time><div><strong>그 이후의 대화가 있나요?</strong><p>달라진 상황과 추가 자료를 이어서 정리해요.</p></div><i class="is-pending">확인 필요</i></li></ol></div>}

                  {feature.id === "report" && <div class="blue-app-report"><div class="blue-app-report-paper"><span class="blue-app-small-heading">내가 검토하는 상담 준비 리포트</span><h4>길었던 이야기,<br />중요한 내용부터 선명하게.</h4><div><span>01</span><strong>사건의 흐름</strong><CheckCheck size={16} aria-hidden="true" /></div><div><span>02</span><strong>확인한 사실과 준비 자료</strong><CheckCheck size={16} aria-hidden="true" /></div><div><span>03</span><strong>상담에서 확인할 질문</strong><CheckCheck size={16} aria-hidden="true" /></div></div><aside class="blue-app-review"><span><ShieldCheck size={24} aria-hidden="true" /></span><strong>마지막 확인은,<br />내가 직접.</strong><p>사실과 날짜를 확인하고<br />필요한 부분은 수정해요.</p><div><Check size={13} aria-hidden="true" />내용 검토</div><div><Check size={13} aria-hidden="true" />전달할 자료 선택</div><small>공유는 내가 결정해요.</small></aside></div>}

                  <div class="blue-reveal-panel-footer"><span><ShieldCheck size={13} aria-hidden="true" />이해를 돕기 위한 가상 화면이에요.</span><a href="#try-baro" data-blue-demo={feature.id}>{feature.action}<ArrowRight size={15} aria-hidden="true" /></a></div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
      <p class="blue-reveal-bottom"><span data-blue-counter>01 / 04</span><span>스크롤하거나 기능을 눌러 둘러보세요.</span><span>결정은 언제나, 당신에게.</span></p>
    </div>
  </div>
</section>
<script>
  import "../../client/landing-blue-reveal";
</script>
