---
import {
  // biome-ignore lint/correctness/noUnusedImports: The Astro template renders these icons.
  ArrowDown,
  ArrowRight,
  Check,
  CheckCheck,
  FileText,
  FolderOpen,
  Image,
  MapPin,
  MessageCircle,
  Mic,
  Search,
  ShieldCheck,
  Sparkles,
} from "lucide-react";
import "../../styles/landing-logo.css";

// biome-ignore lint/correctness/noUnusedVariables: The Astro template renders the exact brand paths.
const logoPaths = [
  "M24.5 3.8C28 1.9 31 4 31 8v48c0 4-3 6.1-6.5 4.2L12.7 54C8.5 51.8 7 49 7 44.5v-25C7 15 8.5 12.2 12.7 10L24.5 3.8Z",
  "M39 12h8c8.3 0 15 5.1 15 11.5S55.3 35 47 35h-8a3 3 0 0 1-3-3V15a3 3 0 0 1 3-3Z",
  "M39 38h8c8.3 0 15 5.1 15 11.5S55.3 61 47 61h-8a3 3 0 0 1-3-3V41a3 3 0 0 1 3-3Z",
];

// biome-ignore lint/correctness/noUnusedVariables: Feature content is rendered by the Astro template.
const features = [
  {
    id: "conversation",
    label: "편한 대화",
    title: "잘 정리하지 않아도,\n이야기할 수 있게.",
    body: "법률 용어 없이 내 말로 시작하세요. BARO가 필요한 질문을 건네며 중요한 사실을 함께 정리해요.",
    benefit: "첫 문장의 부담을 덜어요",
    icon: MessageCircle,
    demo: "conversation",
    cta: "대화 직접 체험하기",
  },
  {
    id: "files",
    label: "자료 모으기",
    title: "흩어져 있던 기록을,\n이야기 곁에.",
    body: "메시지, 사진, 문서, 녹음. 필요한 자료를 사건별로 모으고, 어떤 사실과 연결되는지 살펴봐요.",
    benefit: "여기저기 찾는 수고를 줄여요",
    icon: FolderOpen,
    demo: "files",
    cta: "자료 정리 체험하기",
  },
  {
    id: "timeline",
    label: "사건의 흐름",
    title: "뒤섞인 기억도,\n순서가 보이도록.",
    body: "언제 무슨 일이 있었는지 날짜순으로 확인해요. 확인된 사실과 아직 확인할 내용을 나눠 볼 수 있어요.",
    benefit: "긴 이야기를 한눈에 이해해요",
    icon: CheckCheck,
    demo: "timeline",
    cta: "타임라인 체험하기",
  },
  {
    id: "report",
    label: "상담 리포트",
    title: "다시 설명할 걱정을,\n조금 더 가볍게.",
    body: "정리한 사실과 자료, 상담에서 확인할 질문을 리포트에 담아요. 직접 검토한 내용으로 상담을 준비하세요.",
    benefit: "첫 상담 전 준비를 도와요",
    icon: FileText,
    demo: "report",
    cta: "리포트 직접 체험하기",
  },
  {
    id: "lawyers",
    label: "변호사 찾기",
    title: "내게 필요한 전문가,\n내 기준으로.",
    body: "분야와 지역으로 공개된 프로필을 살펴보세요. 누구에게 연락할지 직접 선택하고 이야기할 수 있어요.",
    benefit: "선택에 필요한 정보를 살펴봐요",
    icon: Search,
    demo: null,
    cta: "변호사 프로필 살펴보기",
  },
  {
    id: "review",
    label: "검토와 선택",
    title: "내 이야기를 전하는 일,\n결정은 내가.",
    body: "정리한 내용을 확인하고 고쳐요. 어떤 자료를 누구에게 전달할지, 마지막 선택은 언제나 나에게 있어요.",
    benefit: "검토하고 필요한 것만 전달해요",
    icon: ShieldCheck,
    demo: "report",
    cta: "리포트 검토 체험하기",
  },
];
---

<section id="logo-experience" class="logo-experience" data-logo-experience aria-labelledby="logo-experience-title">
  <div class="logo-experience-sticky">
    <div class="logo-experience-glow" aria-hidden="true"></div>
    <div class="logo-experience-inner">
      <header class="logo-experience-heading">
        <p><span></span> ONE BARO, YOUR NEXT STEP</p>
        <h2 id="logo-experience-title">하나의 BARO 안에,<br /><span>당신을 위한 모든 준비.</span></h2>
      </header>
      <div class="logo-experience-grid">
        <div class="logo-experience-stage">
          <div class="logo-experience-rings" aria-hidden="true"><i></i><i></i><i></i></div>
          <div class="logo-experience-mark" aria-hidden="true">
            <div class="logo-experience-mark-turn">
              {logoPaths.map((path, index) => (
                <svg class={`logo-experience-piece logo-experience-piece-${index}`} data-logo-piece={index} viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg">
                  <defs><linearGradient id={`logo-experience-blue-${index}`} x1="8" y1="4" x2="56" y2="60" gradientUnits="userSpaceOnUse"><stop stop-color="#51b1ff" /><stop offset="1" stop-color="#2864ff" /></linearGradient></defs>
                  <path d={path} fill={`url(#logo-experience-blue-${index})`} />
                </svg>
              ))}
            </div>
          </div>
          <div class="logo-experience-orbit" aria-label="BARO 기능 선택">
            {features.map((feature, index) => (
              <button type="button" class="logo-feature-tile" data-logo-feature={index} aria-controls={`logo-feature-panel-${index}`} aria-pressed={index === 0 ? "true" : "false"}>
                <span class="logo-feature-tile-face"><span class="logo-feature-tile-icon"><feature.icon size={28} aria-hidden="true" /></span><span class="logo-feature-tile-label">{feature.label}</span><span class="logo-feature-tile-number">0{index + 1}</span></span>
              </button>
            ))}
          </div>
          <div class="logo-experience-center" aria-hidden="true"><img src="/brand/logo.svg" alt="" width="35" height="35" /><strong>BARO</strong><span>당신의 다음 한 걸음</span></div>
          <p class="logo-experience-stage-caption"><span>360°</span><i></i> 스크롤하면, 하나씩 펼쳐져요</p>
        </div>

        <div class="logo-experience-details">
          <div class="logo-experience-intro" aria-hidden="true"><span class="logo-experience-intro-icon"><Sparkles size={25} /></span><h3>막막했던 일도,<br />이렇게 풀어가요.</h3><p>편한 대화부터 상담 준비까지.<br />필요한 도움을 하나씩 만나보세요.</p><span class="logo-experience-scroll"><ArrowDown size={16} /> 아래로 스크롤해 보세요</span></div>
          <div class="logo-experience-panels">
            {features.map((feature, index) => (
              <article class="logo-feature-panel" id={`logo-feature-panel-${index}`} data-logo-panel={index} aria-labelledby={`logo-feature-title-${index}`}>
                <p class="logo-feature-kicker"><span>0{index + 1}</span>{feature.label}</p>
                <h3 id={`logo-feature-title-${index}`}>{feature.title.split("\n").map((line) => <span>{line}</span>)}</h3>
                <p class="logo-feature-description">{feature.body}</p>
                <div class="logo-feature-preview" aria-label={`${feature.label} 가상 화면 예시`}>
                  <div class="logo-feature-preview-bar"><img src="/brand/logo.svg" alt="" width="17" height="17" /><strong>BARO</strong><span>{feature.label}</span><i>예시</i></div>
                  {feature.id === "conversation" && <div class="logo-preview-chat"><p class="logo-preview-chat-me">돈을 빌려줬는데 아직 못 받았어요.</p><p class="logo-preview-chat-baro"><Sparkles size={16} /><span>언제, 어떤 방법으로 빌려주셨나요?<br /><small>기억나는 것부터 편하게 알려주세요.</small></span></p><div class="logo-preview-input">내 말로 편하게 이야기해 주세요<ArrowRight size={14} /></div></div>}
                  {feature.id === "files" && <div class="logo-preview-files"><div><FileText size={23} /><span>계좌 이체 내역.pdf<small>대여 사실과 연결</small></span><Check size={15} /></div><div><Image size={23} /><span>주고받은 대화.png<small>반환 약속 확인</small></span><Check size={15} /></div><div><Mic size={23} /><span>통화 녹음.m4a<small>함께 확인할 자료</small></span><Check size={15} /></div></div>}
                  {feature.id === "timeline" && <ol class="logo-preview-timeline"><li><time>03.12</time><div><strong>돈을 빌려줬어요</strong><span>계좌 이체 내역과 함께</span></div><i>자료 연결</i></li><li><time>04.12</time><div><strong>약속한 날짜가 지났어요</strong><span>대화에 남은 반환 예정일</span></div></li><li><time>다음</time><div><strong>추가 대화를 확인해요</strong><span>아직 확인이 필요한 내용</span></div></li></ol>}
                  {feature.id === "report" && <div class="logo-preview-report"><div class="logo-preview-report-head"><FileText size={30} /><span>나의 상담 준비 리포트<small>내가 검토한 사실과 선택한 자료</small></span></div><div><CheckCheck size={15} />사건의 흐름<Check size={14} /></div><div><FolderOpen size={15} />확인한 사실과 자료<Check size={14} /></div><div><MessageCircle size={15} />상담에서 확인할 질문<Check size={14} /></div></div>}
                  {feature.id === "lawyers" && <div class="logo-preview-lawyers"><div class="logo-preview-filters"><span><MapPin size={12} />지역</span><span>대여금</span><span>임대차</span><span>근로</span></div><div class="logo-preview-profile"><span><Search size={27} /></span><div><strong>공개된 프로필을 살펴봐요</strong><p>활동 지역 · 주요 분야 · 연락 방법</p></div></div><p class="logo-preview-lawyers-note">프로필 탐색<ArrowRight size={13} />내가 선택<ArrowRight size={13} />직접 연락</p></div>}
                  {feature.id === "review" && <div class="logo-preview-review"><p><ShieldCheck size={20} /><span>공유 전에, 한 번 더 확인해요</span></p><div><span class="logo-preview-checkbox"><Check size={12} /></span><strong>직접 확인한 리포트</strong><span>선택</span></div><div><span class="logo-preview-checkbox"><Check size={12} /></span><strong>계좌 이체 내역.pdf</strong><span>선택</span></div><div><span class="logo-preview-checkbox is-empty"></span><strong>추가 개인 메모</strong><span>제외</span></div></div>}
                </div>
                <p class="logo-feature-benefit"><Check size={15} aria-hidden="true" />{feature.benefit}</p>
                <a class="logo-feature-cta" href={feature.demo ? "#try-baro" : "/lawyers"} data-logo-demo={feature.demo ?? undefined}>{feature.cta}<ArrowRight size={17} aria-hidden="true" /></a>
              </article>
            ))}
          </div>
        </div>
      </div>
      <p class="logo-experience-disclaimer">미리보기는 기능 이해를 위한 가상 화면이에요.</p>
    </div>
  </div>
</section>
<script>
  import "../../client/landing-logo";
</script>
