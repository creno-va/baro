---
// biome-ignore lint/correctness/noUnusedImports: Astro renders the island.
import { ConsentForm } from "../components/ConsentForm";
// biome-ignore lint/correctness/noUnusedImports: Astro renders the components.
import { ReadingContent } from "../components/ui/reading-content";
// biome-ignore lint/correctness/noUnusedImports: Astro renders the components.
import { StatePanel } from "../components/ui/state-panel";
// biome-ignore lint/correctness/noUnusedImports: Astro renders the layout.
import PublicLayout from "../layouts/PublicLayout.astro";
---
<PublicLayout title="필수 확인 · BARO" description="BARO 이용 전 서비스 정책을 확인합니다." showStart={false}>
  <ReadingContent className="ui-auth ui-stack">
    <ConsentForm client:only="react"><StatePanel slot="fallback" variant="loading" title="이용 상태를 확인하고 있어요." /></ConsentForm>
    <noscript><p>동의 상태를 확인하려면 브라우저에서 JavaScript를 켜 주세요.</p></noscript>
  </ReadingContent>
</PublicLayout>
