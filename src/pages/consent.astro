---
// biome-ignore lint/correctness/noUnusedImports: Astro renders the consent island.
import { ConsentForm } from "../components/ConsentForm";
// biome-ignore lint/correctness/noUnusedImports: Astro renders the new public frame.
import ProductPublicLayout from "../layouts/ProductPublicLayout.astro";
---
<ProductPublicLayout title="필수 확인 — BARO" description="BARO 이용 전 서비스 정책을 확인합니다." width="auth" navigationLabel="필수 확인 화면">
  <div class="rounded-2xl border border-[var(--pui-border)] bg-[var(--pui-surface)] p-5 sm:p-7">
    <ConsentForm client:only="react"><p slot="fallback" data-product-consent-status="" class="text-sm leading-6 text-[var(--pui-muted)]" role="status">이용 상태를 확인하고 있어요.</p></ConsentForm>
    <noscript><p class="mt-4 text-sm leading-6">동의 상태를 확인하려면 브라우저에서 JavaScript를 켜 주세요.</p></noscript>
  </div>
</ProductPublicLayout>
