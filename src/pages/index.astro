---
// biome-ignore lint/correctness/noUnusedImports: Astro renders these components.
import { ButtonLink } from "../components/ui/button";
// biome-ignore lint/correctness/noUnusedImports: Astro renders these components.
import { InlineNotice } from "../components/ui/inline-notice";
// biome-ignore lint/correctness/noUnusedImports: Astro renders these components.
import { PageHeader } from "../components/ui/page-header";
// biome-ignore lint/correctness/noUnusedImports: Astro renders these components.
import { ReadingContent } from "../components/ui/reading-content";
// biome-ignore lint/correctness/noUnusedImports: Astro renders these components.
import { ActionGroup, Section } from "../components/ui/section";
// biome-ignore lint/correctness/noUnusedImports: Astro renders the layout.
import PublicLayout from "../layouts/PublicLayout.astro";
---
<PublicLayout title="BARO · 내 사건을 이해하고 준비하기" description="민사 준비·대응, 형사 고소 준비·대응에 필요한 사실과 자료를 정리하고 리포트를 반복해서 확인하세요.">
  <ReadingContent className="ui-stack">
    <PageHeader eyebrow="사건 준비를 위한 BARO" title="내 사건을 이해하고, 다음 준비를 차근차근" description="민사 준비·대응부터 형사 고소 준비·대응까지. 알고 있는 이야기와 자료를 정리하고, 준비하는 동안 리포트를 확인하세요." />
    <ActionGroup>
      <ButtonLink href="/app">내 사건 준비하기</ButtonLink>
      <ButtonLink href="/help" variant="secondary">이용 방법 보기</ButtonLink>
    </ActionGroup>
    <Section title="알고 있는 이야기에서 시작해요" id="how-it-works">
      <ol class="ui-stack">
        <li><h3>이야기를 적어요</h3><p>지금까지 있었던 일과 준비하려는 내용을 알려 주세요. 모든 자료를 갖추지 않아도 시작할 수 있어요.</p></li>
        <li><h3>대화와 자료로 정리해요</h3><p>질문에 답하고 요약을 확인해요. 사건에 자료를 더하고 사실·주장·아직 확인하지 못한 내용을 살펴보세요.</p></li>
        <li><h3>리포트로 다시 확인해요</h3><p>사건을 준비하며 정리한 내용과 근거를 반복해서 확인해요. 새 버전을 만들 때는 기존 편집과 달라진 내용을 확인하세요.</p></li>
      </ol>
    </Section>
    <Section title="사건 준비에 필요한 내용을 한곳에서" id="preparation">
      <div class="ui-grid">
        <div><h3>사실과 자료</h3><p>날짜·금액·경위를 정리하고 관련 자료와 확인할 내용을 함께 살펴봐요.</p></div>
        <div><h3>리포트와 준비할 행동</h3><p>사건 내용을 검토하고 다음에 확인할 일을 정리해요. 리포트는 직접 확인한 뒤 PDF로 보관할 수 있어요.</p></div>
      </div>
    </Section>
    <InlineNotice title="AI가 정리한 내용은 직접 확인해 주세요" tone="warning">
      <p>AI는 자료를 잘못 읽거나 내용을 빠뜨릴 수 있어요. 법률 판단과 중요한 결정·기한은 공식 원문 또는 자격 있는 전문가를 통해 확인해 주세요. BARO는 사건 결과를 보장하지 않으며 변호사 연결 기능은 제공하지 않습니다.</p>
    </InlineNotice>
    <Section title="준비할 내용을 하나씩 정리해 보세요">
      <p>Google·네이버·카카오 계정으로 로그인한 뒤 이용할 수 있어요. 기존 계정에서도 본인 사건과 자료·리포트를 계속 확인할 수 있어요.</p><ButtonLink href="/app">내 사건 준비하기</ButtonLink>
    </Section>
  </ReadingContent>
</PublicLayout>
