---
// biome-ignore lint/correctness/noUnusedImports: Astro renders these components.
import { ButtonLink } from "../components/ui/button";
// biome-ignore lint/correctness/noUnusedImports: Astro renders these components.
import { PageHeader } from "../components/ui/page-header";
// biome-ignore lint/correctness/noUnusedImports: Astro renders these components.
import { ReadingContent } from "../components/ui/reading-content";
// biome-ignore lint/correctness/noUnusedImports: Astro renders these components.
import { ActionGroup } from "../components/ui/section";
// biome-ignore lint/correctness/noUnusedImports: Astro renders these components.
import { StatePanel } from "../components/ui/state-panel";
// biome-ignore lint/correctness/noUnusedImports: Astro renders the layout.
import PublicLayout from "../layouts/PublicLayout.astro";

Astro.response.status = 404;
---
<PublicLayout title="페이지를 찾을 수 없어요 · BARO" description="주소를 확인하거나 홈과 내 사건으로 이동해 주세요.">
  <ReadingContent className="ui-stack">
    <PageHeader eyebrow="404" title="페이지를 찾을 수 없어요" />
    <StatePanel variant="empty" title="주소를 다시 확인해 주세요" description="주소가 바뀌었거나 존재하지 않는 페이지예요. 홈에서 다시 시작하거나 내 사건을 확인할 수 있어요." />
    <ActionGroup><ButtonLink href="/" variant="secondary">홈으로</ButtonLink><ButtonLink href="/new">내 사건으로</ButtonLink></ActionGroup>
  </ReadingContent>
</PublicLayout>
