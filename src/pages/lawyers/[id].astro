---
// biome-ignore lint/correctness/noUnusedImports: Astro template reads the island.
import { Profile } from "../../components/lawyers/Profile";
import { opaqueIdSchema } from "../../contracts";
// biome-ignore lint/correctness/noUnusedImports: Astro template reads the layout.
import AppLayout from "../../layouts/AppLayout.astro";

const parsed = opaqueIdSchema.safeParse(Astro.params.id);
if (!parsed.success) return Astro.redirect("/lawyers");
// biome-ignore lint/correctness/noUnusedVariables: Astro template reads the prop.
const id = parsed.data;
// biome-ignore lint/correctness/noUnusedVariables: Astro template reads the prop.
const preview = Astro.url.hostname !== "baro.site";
---
<AppLayout title="변호사 프로필" description="승인된 변호사 소개와 연락처를 확인하세요." role="visitor" availableRoutes={["/", "/lawyers"]}>
  <Profile id={id} preview={preview} client:load />
</AppLayout>
