---
// biome-ignore lint/correctness/noUnusedImports: Astro renders the island.
import { AuthButtons } from "../components/AuthButtons";
// biome-ignore lint/correctness/noUnusedImports: Astro renders the components.
import { InlineNotice } from "../components/ui/inline-notice";
// biome-ignore lint/correctness/noUnusedImports: Astro renders the components.
import { PageHeader } from "../components/ui/page-header";
// biome-ignore lint/correctness/noUnusedImports: Astro renders the components.
import { ReadingContent } from "../components/ui/reading-content";
// biome-ignore lint/correctness/noUnusedImports: Astro renders the layout.
import PublicLayout from "../layouts/PublicLayout.astro";

// biome-ignore lint/correctness/noUnusedVariables: Used in the Astro template.
const oauthFailed = Astro.url.searchParams.has("error");
const oauthErrors = Astro.url.searchParams.getAll("error");
// biome-ignore lint/correctness/noUnusedVariables: Used in the Astro template.
const errorMessage = oauthErrors.includes("account_not_linked")
  ? "이메일 소유 확인이 없어 계정을 연결하지 못했어요. 이메일이 인증된 소셜 계정이나 기존에 사용한 로그인 방법으로 계속해 주세요."
  : oauthErrors.includes("unable_to_link_account")
    ? "계정 연결을 완료하지 못했어요. 잠시 후 다시 시도하거나 기존에 사용한 로그인 방법으로 계속해 주세요."
    : oauthErrors.includes("access_denied")
      ? "로그인을 취소했어요. 원하는 계정을 다시 선택해 주세요."
      : oauthErrors.includes("session_expired")
        ? "안전한 이용을 위해 다시 로그인해 주세요."
        : "로그인이 완료되지 않았어요. 다시 선택해 주세요.";
---
<PublicLayout title="로그인 · 회원가입 — BARO" description="Google·네이버·카카오 계정으로 로그인하고 내 사건 준비를 이어가세요." showStart={false}>
  <ReadingContent className="ui-auth ui-stack">
    <PageHeader title="로그인 · 회원가입" description="사용하던 소셜 계정으로 내 사건 준비를 이어가세요. 처음이라면 같은 방법으로 시작할 수 있어요." />
    {oauthFailed && <InlineNotice tone="danger" title={errorMessage} announce />}
    <AuthButtons client:load />
    <p class="ui-muted">기존 계정의 본인 사건·자료·리포트를 계속 이용할 수 있어요.</p>
    <nav class="ui-cluster" aria-label="로그인 안내"><a class="ui-link" href="/policies/terms">이용약관</a><a class="ui-link" href="/policies/privacy">개인정보 처리방침</a><a class="ui-link" href="/help#login">로그인에 어려움이 있나요?</a></nav>
  </ReadingContent>
</PublicLayout>
