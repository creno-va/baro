---
// biome-ignore lint/correctness/noUnusedImports: Astro renders the login island.
import { AuthButtons } from "../components/AuthButtons";
// biome-ignore lint/correctness/noUnusedImports: Astro renders the new public frame.
import ProductPublicLayout from "../layouts/ProductPublicLayout.astro";

// biome-ignore lint/correctness/noUnusedVariables: Used in the Astro template.
const oauthFailed = Astro.url.searchParams.has("error");
const oauthErrors = Astro.url.searchParams.getAll("error");
// biome-ignore lint/correctness/noUnusedVariables: Used in the Astro template.
const errorMessage = oauthErrors.includes("account_not_linked")
  ? "이메일 소유 확인이 없어 계정을 연결하지 못했어요. 이메일이 인증된 소셜 계정이나 기존에 사용한 로그인 방법으로 계속해 주세요."
  : oauthErrors.includes("unable_to_link_account")
    ? "계정 연결을 완료하지 못했어요. 잠시 후 다시 시도하거나 기존에 사용한 로그인 방법으로 계속해 주세요."
    : oauthErrors.includes("access_denied")
      ? "로그인을 취소했어요. 원하는 계정을 다시 선택해 주세요."
      : oauthErrors.includes("session_expired")
        ? "안전한 이용을 위해 다시 로그인해 주세요."
        : "로그인이 완료되지 않았어요. 다시 선택해 주세요.";
---
<ProductPublicLayout title="로그인 — BARO" description="Google, Naver 또는 Kakao 계정으로 BARO에 로그인합니다." width="auth" navigationLabel="로그인 화면">
  <div data-product-login="" class="space-y-8">
    <header class="space-y-3">
      <p class="text-3xl font-semibold leading-tight tracking-tight">법률 고민의 시작, <br />바로와 함께.</p>
      <p class="text-sm leading-7 text-[var(--pui-muted)]">막막한 순간부터, 다음 한 걸음까지.</p>
    </header>
    <section aria-labelledby="login-title" class="space-y-6 rounded-2xl border border-[var(--pui-border)] bg-[var(--pui-surface)] p-5 sm:p-7">
      <div class="space-y-2">
        <h1 id="login-title" class="text-xl font-semibold tracking-tight">로그인 · 회원가입</h1>
        <p data-product-login-description="" class="text-sm leading-6 text-[var(--pui-muted)]">소셜 계정으로 내 사건 정리를 시작하세요.</p>
      </div>
      {oauthFailed && <p data-product-login-callback-error="" class="rounded-xl border border-[var(--pui-danger)] p-3 text-sm leading-6 text-[var(--pui-danger)]" role="alert">{errorMessage}</p>}
      <AuthButtons client:load />
      <footer class="space-y-3 border-t border-[var(--pui-border)] pt-4 text-xs leading-6 text-[var(--pui-muted)] [&_a]:inline-flex [&_a]:min-h-11 [&_a]:items-center [&_a]:rounded [&_a]:underline [&_a]:underline-offset-4 [&_a]:focus-visible:outline-2 [&_a]:focus-visible:outline-[var(--pui-focus)]">
        <div class="flex flex-wrap items-center gap-2"><a href="/policies/terms">이용약관</a><span aria-hidden="true">·</span><a href="/policies/privacy">개인정보 처리방침</a></div>
        <a href="/help">로그인에 어려움이 있나요?</a>
      </footer>
    </section>
  </div>
</ProductPublicLayout>
