---
// biome-ignore lint/correctness/noUnusedImports: Astro resolves component imports in the template.
import { AuthButtons } from "../components/AuthButtons";
// biome-ignore lint/correctness/noUnusedImports: Astro resolves component imports in the template.
import BaseLayout from "../layouts/BaseLayout.astro";

// biome-ignore lint/correctness/noUnusedVariables: Used in the Astro template.
const oauthFailed = Astro.url.searchParams.has("error");
---

<BaseLayout title="로그인 — BARO" description="Google, Naver 또는 Kakao 계정으로 BARO에 로그인합니다.">
  <main class="auth-shell">
    <a class="brand" href="/" aria-label="BARO 홈">BARO</a>
    <section class="auth-card" aria-labelledby="login-title">
      <p class="eyebrow">로그인</p>
      <h1 id="login-title">계정으로 계속하기</h1>
      <p class="lede">비밀번호를 새로 만들지 않고 기존 계정으로 안전하게 시작합니다.</p>
      {oauthFailed && <p class="form-error" role="alert">로그인이 완료되지 않았어요. 다시 선택해 주세요.</p>}
      <AuthButtons client:load />
    </section>
  </main>
</BaseLayout>
