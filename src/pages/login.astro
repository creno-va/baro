---
// biome-ignore lint/correctness/noUnusedImports: Astro resolves component imports in the template.
import { AuthButtons } from "../components/AuthButtons";
// biome-ignore lint/correctness/noUnusedImports: Astro template reads component.
import { Brand } from "../components/ui/brand";
// biome-ignore lint/correctness/noUnusedImports: Astro resolves component imports in the template.
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/login.css";

// biome-ignore lint/correctness/noUnusedVariables: Used in the Astro template.
const oauthFailed = Astro.url.searchParams.has("error");
// biome-ignore lint/correctness/noUnusedVariables: Used in the Astro template.
const errorMessage =
  Astro.url.searchParams.get("error") === "access_denied"
    ? "로그인을 취소했어요. 원하는 계정을 다시 선택해 주세요."
    : Astro.url.searchParams.get("error") === "session_expired"
      ? "안전한 이용을 위해 다시 로그인해 주세요."
      : "로그인이 완료되지 않았어요. 다시 선택해 주세요.";
---

<BaseLayout title="로그인 — BARO" description="Google, Naver 또는 Kakao 계정으로 BARO에 로그인합니다.">
  <main id="main-content" tabindex="-1" class="login-page">
    <nav class="login-navigation" aria-label="로그인 화면">
      <a class="login-back" href="/" aria-label="홈으로 돌아가기">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m12 5-7 7 7 7M5 12h15" />
        </svg>
      </a>
      <span>로그인 · 회원가입</span>
    </nav>
    <section class="login-content" aria-labelledby="login-title">
      <header class="login-intro">
        <h1 id="login-title">법률 고민의 시작,<br />바로와 함께.</h1>
        <Brand />
        <p class="login-intro__caption">막막한 순간부터, 다음 한 걸음까지.</p>
      </header>
      {oauthFailed && <p class="form-error login-callback-error" role="alert">{errorMessage}</p>}
      <AuthButtons client:load />
    </section>
    <footer class="login-footer">
      <a class="login-help" href="/help">로그인에 어려움이 있나요?</a>
      <p>처음이라면, 로그인 후 바로 가입할 수 있어요.</p>
      <div class="login-policy-links">
        <a href="/policies/terms">이용약관</a>
        <span aria-hidden="true">·</span>
        <a href="/policies/privacy">개인정보 처리방침</a>
      </div>
    </footer>
  </main>
</BaseLayout>
