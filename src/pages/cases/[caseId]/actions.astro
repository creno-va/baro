---
// biome-ignore lint/correctness/noUnusedImports: Astro renders the React application.
import { WebApp } from "../../../components/web/WebApp";
import { opaqueIdSchema } from "../../../contracts";
// biome-ignore lint/correctness/noUnusedImports: Astro renders the document layout.
import BaseLayout from "../../../layouts/BaseLayout.astro";

const identity = opaqueIdSchema.safeParse(Astro.params.caseId);
if (!identity.success) return Astro.redirect("/new", 302);
// biome-ignore lint/correctness/noUnusedVariables: Astro passes this validated ID to the island.
const caseId = identity.data;
Astro.response.headers.set("Cache-Control", "private, no-store");
---
<BaseLayout title="다음 행동 · BARO" description="사건의 대화, 자료, 요약과 리포트를 한곳에서 확인합니다.">
  <WebApp initialCaseId={caseId} initialTab="actions" client:only="react" />
  <noscript><main id="main-content"><p>사건을 확인하려면 JavaScript를 켜 주세요.</p></main></noscript>
</BaseLayout>
