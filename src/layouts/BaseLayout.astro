---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
}

// biome-ignore lint/correctness/noUnusedVariables: Astro resolves frontmatter variables in the template.
const { title, description } = Astro.props;
const validationBootstrap = "Object.assign(globalThis, { __zod_globalConfig: { jitless: true } });";
const bootstrapDigest = await crypto.subtle.digest(
  "SHA-256",
  new TextEncoder().encode(validationBootstrap),
);
Astro.csp?.insertScriptHash(
  `sha256-${btoa(String.fromCharCode(...new Uint8Array(bootstrapDigest)))}`,
);
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <!-- Configure validation before island modules construct schemas under the hash CSP. -->
    <script is:inline set:html={validationBootstrap} />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/brand/logo.svg" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">본문으로 건너뛰기</a>
    <slot />
  </body>
</html>
