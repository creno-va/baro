---
import "../styles/web.css";
import "../styles/web-public.css";
import "../styles/web-resources.css";

interface Props {
  title: string;
  description: string;
  startAtTop?: boolean;
}
// biome-ignore lint/correctness/noUnusedVariables: Astro template reads these values.
const { title, description } = Astro.props;
Astro.response.headers.set("Cache-Control", "private, no-store, no-transform");
// Configure Zod before schemas load under the production hash-only script policy.
const bootstrap =
  "Object.assign(globalThis,{__zod_globalConfig:{jitless:true}});try{document.documentElement.dataset.theme=localStorage.getItem('baro-theme')==='dark'?'dark':'light'}catch(e){document.documentElement.dataset.theme='light'}";
const digest = await crypto.subtle.digest("SHA-256", new TextEncoder().encode(bootstrap));
Astro.csp?.insertScriptHash(`sha256-${btoa(String.fromCharCode(...new Uint8Array(digest)))}`);
---
<!doctype html>
<html lang="ko" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <script is:inline set:html={bootstrap} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/brand/logo.svg" />
    <link rel="preload" href="/fonts/PretendardVariable.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
  </head>
  <body>
    <a class="web-skip" href="#main-content">본문으로 건너뛰기</a>
    <slot />
  </body>
</html>
