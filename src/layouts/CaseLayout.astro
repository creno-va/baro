---
// biome-ignore lint/correctness/noUnusedImports: Astro template reads component.
import AppLayout from "./AppLayout.astro";
import "../styles/cases.css";
import { env } from "cloudflare:workers";

interface Props {
  title: string;
}
// biome-ignore lint/correctness/noUnusedVariables: Astro template reads frontmatter.
const { title } = Astro.props;
// biome-ignore lint/correctness/noUnusedVariables: Astro template reads frontmatter.
const environment =
  env.APP_ENV === "production" ? "production" : env.APP_ENV === "preview" ? "preview" : "local";
// Only case-service pages preview explicitly fetched private recordings.
Astro.csp?.insertDirective("media-src 'self' data:");
// Unsent chat photos are local object URLs; allow previews only on case pages.
Astro.csp?.insertDirective("img-src 'self' data: blob:");
---
<AppLayout title={`${title} · BARO`} description="사건의 사실관계와 상담 준비를 차근차근 정리하세요." role="user" availableRoutes={["/app", "/cases", "/lawyers", "/settings"]} contentClass="case-shell">
    <slot />
    <script id="baro-tab-history" type="application/json" data-environment={environment} data-release={env.RELEASE_SHA}></script>
    <aside class="case-notice">BARO는 법률 자문을 제공하지 않습니다. AI 결과와 중요한 결정·기한은 공식 원문 또는 자격 있는 전문가를 통해 확인해 주세요.</aside>
</AppLayout>

<script>
  import { configureAnalytics } from "../server/modules/analytics/browser";

  const config = document.getElementById("baro-tab-history");
  const environment = config?.dataset.environment;
  if (environment === "local" || environment === "preview" || environment === "production") {
    configureAnalytics({ environment, release: config?.dataset.release ?? "local" });
  }
</script>
