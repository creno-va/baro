---
import { ProductUIFixture } from "./product-ui-fixture";
import "./product-ui-fixture.css";
import "../../src/product-ui/tokens.css";

Astro.response.headers.set("Cache-Control", "private, no-store, no-transform");
const validationBootstrap = "Object.assign(globalThis, { __zod_globalConfig: { jitless: true } });";
const bootstrapDigest = await crypto.subtle.digest(
  "SHA-256",
  new TextEncoder().encode(validationBootstrap),
);
Astro.csp?.insertScriptHash(
  `sha256-${btoa(String.fromCharCode(...new Uint8Array(bootstrapDigest)))}`,
);
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <script is:inline set:html={validationBootstrap} />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="독립된 공통 UI 검토 화면" />
    <link rel="icon" type="image/svg+xml" href="/brand/logo.svg" />
    <title>공통 UI 기반 검토 · BARO</title>
  </head>
  <body class="font-sans antialiased">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:rounded-lg focus:bg-white focus:px-4 focus:py-3 focus:text-black">본문으로 건너뛰기</a>
    <ProductUIFixture client:load />
    <noscript>이 검토 화면의 상호작용에는 JavaScript가 필요합니다.</noscript>
  </body>
</html>
