{
  "name": "baro",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:preview": "cross-env CLOUDFLARE_ENV=preview astro build",
    "build:production": "cross-env CLOUDFLARE_ENV=production astro build",
    "preview": "astro preview",
    "lint": "biome check src scripts tests .github/scripts astro.config.ts drizzle.config.ts playwright.config.ts playwright.csp.config.ts package.json tsconfig.json tsconfig.tools.json wrangler.jsonc",
    "lint:fix": "biome check --write src scripts tests .github/scripts astro.config.ts drizzle.config.ts playwright.config.ts playwright.csp.config.ts package.json tsconfig.json tsconfig.tools.json wrangler.jsonc",
    "typecheck": "astro check && tsc --noEmit && tsc --noEmit -p tsconfig.tools.json",
    "test": "bun test",
    "test:ui": "playwright test",
    "test:csp": "playwright test --config playwright.csp.config.ts",
    "cf:types": "wrangler types --strict-vars false",
    "cf:dry-run": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "db:generate": "drizzle-kit generate",
    "db:check": "bun scripts/check-migrations.ts",
    "docs:check": "bun .github/scripts/check-docs.ts",
    "work:check": "bun scripts/work-items.ts",
    "work:next": "bun scripts/work-items.ts --live",
    "release:check": "bun scripts/check-release.ts",
    "boundaries:check": "bun scripts/check-boundaries.ts",
    "eval:offline": "bun scripts/eval-offline.ts",
    "bundle:check": "bun scripts/check-bundle.ts",
    "check": "bun run docs:check && bun run work:check && bun run boundaries:check && bun run lint && bun run typecheck && bun test && bun run db:check",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:preview": "wrangler d1 migrations apply DB --env preview --remote",
    "db:migrate:production": "wrangler d1 migrations apply DB --env production --remote"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.3.3",
    "@astrojs/react": "7.0.0",
    "@cloudflare/containers": "0.3.7",
    "@noble/hashes": "2.4.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.5",
    "better-auth": "1.7.7",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.3",
    "hono": "4.13.13",
    "lucide-react": "1.52.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.63.0",
    "@types/bun": "1.4.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "cross-env": "10.1.0",
    "drizzle-kit": "0.31.11",
    "typescript": "6.0.3",
    "wrangler": "4.147.0"
  },
  "overrides": {
    "esbuild": "0.28.2"
  }
}
