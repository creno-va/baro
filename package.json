{
  "name": "baro",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:preview": "cross-env CLOUDFLARE_ENV=preview astro build",
    "build:production": "cross-env CLOUDFLARE_ENV=production astro build",
    "preview": "astro preview",
    "lint": "biome check src astro.config.ts drizzle.config.ts package.json tsconfig.json wrangler.jsonc",
    "lint:fix": "biome check --write src astro.config.ts drizzle.config.ts package.json tsconfig.json wrangler.jsonc",
    "typecheck": "astro check && tsc --noEmit",
    "test": "bun test",
    "cf:types": "wrangler types",
    "cf:dry-run": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:preview": "wrangler d1 migrations apply DB --env preview --remote",
    "db:migrate:production": "wrangler d1 migrations apply DB --env production --remote"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.3.3",
    "@astrojs/react": "7.0.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.5",
    "better-auth": "1.7.7",
    "drizzle-orm": "0.45.3",
    "hono": "4.13.13",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@biomejs/biome": "2.5.15",
    "@types/bun": "1.4.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "cross-env": "10.1.0",
    "drizzle-kit": "0.31.11",
    "typescript": "6.0.3",
    "wrangler": "4.147.0"
  }
}
